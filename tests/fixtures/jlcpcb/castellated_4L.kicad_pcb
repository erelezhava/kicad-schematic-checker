(kicad_pcb
	(version 20250926)
	(generator "pcbnew")
	(generator_version "10.0")
	(general
		(thickness 0.8)
		(legacy_teardrops no)
	)
	(paper "A4")
	(layers
		(0 "F.Cu" signal)
		(4 "In1.Cu" signal)
		(6 "In2.Cu" signal)
		(2 "B.Cu" signal)
		(5 "F.SilkS" user "F.Silkscreen")
		(1 "F.Mask" user)
		(25 "Edge.Cuts" user)
	)
	(setup
		(stackup
			(layer "F.SilkS" (type "Top Silk Screen"))
			(layer "F.Mask" (type "Top Solder Mask") (color "Black") (thickness 0.01))
			(layer "F.Cu" (type "copper") (thickness 0.035))
			(layer "dielectric 1" (type "prepreg") (thickness 0.1) (material "FR4") (epsilon_r 4.5) (loss_tangent 0.02))
			(layer "In1.Cu" (type "copper") (thickness 0.0175))
			(layer "dielectric 2" (type "core") (thickness 0.5) (material "FR4") (epsilon_r 4.5) (loss_tangent 0.02))
			(layer "In2.Cu" (type "copper") (thickness 0.0175))
			(layer "dielectric 3" (type "prepreg") (thickness 0.1) (material "FR4") (epsilon_r 4.5) (loss_tangent 0.02))
			(layer "B.Cu" (type "copper") (thickness 0.035))
			(layer "B.Mask" (type "Bottom Solder Mask") (color "Black") (thickness 0.01))
			(copper_finish "ENIG")
			(dielectric_constraints no)
		)
		(pad_to_mask_clearance 0)
		(capping no)
		(filling no)
	)
	(net 0 "")
	(net 1 "GND")
	(footprint "Module:Castellated"
		(layer "F.Cu")
		(at 10 10)
		(property "Reference" "M1" (at 0 0 0) (layer "F.SilkS"))
		(pad "1" thru_hole circle (at 0 -4) (size 1.2 1.2) (drill 0.6) (layers "*.Cu" "*.Mask") (property pad_prop_castellated) (net 1 "GND"))
		(pad "2" thru_hole circle (at 1.27 -4) (size 1.2 1.2) (drill 0.6) (layers "*.Cu" "*.Mask") (property pad_prop_castellated))
		(pad "3" connect rect (at 3 0) (size 1 3) (layers "F.Cu" "F.Mask"))
		(pad "4" thru_hole circle (at 5 0) (size 1.6 1.6) (drill 1) (layers "*.Cu" "*.Mask") (backdrill (size 1.2) (layers "B.Cu" "In2.Cu")))
		(pad "5" thru_hole circle (at 7 0) (size 3 3) (drill 2) (layers "*.Cu" "*.Mask") (front_post_machining countersink (size 3) (angle 90)))
	)
	(gr_rect (start 0 0) (end 30 20) (stroke (width 0.05) (type solid)) (fill no) (layer "Edge.Cuts"))
	(gr_arc (start 30 5) (mid 33 10) (end 30 15) (stroke (width 0.05) (type solid)) (layer "Edge.Cuts"))
	(via (at 5 15) (size 0.45) (drill 0.2) (layers "F.Cu" "B.Cu") (net 1))
	(via (at 7 15) (size 0.6) (drill 0.3) (layers "F.Cu" "B.Cu") (net 1))
	(via blind (at 9 15) (size 0.3) (drill 0.1) (layers "F.Cu" "In1.Cu") (net 1))
)
