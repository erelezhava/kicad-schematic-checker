# Credentials for external part-data sources.
#
# 1. Copy this file to ".env" in the same folder:   cp .env.example .env
# 2. Fill in YOUR OWN keys. ".env" is git-ignored, so it never leaves your machine.
# 3. Never put real values in this template; it is committed and shared.
#
# Alternative for all checkouts on one machine: ~/.config/kicad_checker/credentials.env
# Environment variables with the same names override both files (useful in CI).

# DigiKey: https://developer.digikey.com -> Organization -> Production App
#          enable "Product Information V4"; each engineer creates their own app.
DIGIKEY_CLIENT_ID=
DIGIKEY_CLIENT_SECRET=

# Read-only sourcing stock lookups (approved supplier API accounts required).
# LCSC official API: https://www.lcsc.com/agent/
LCSC_APP_KEY=
LCSC_APP_SECRET=
# JLCPCB official Parts API: https://api.jlcpcb.com/
JLCPCB_APP_ID=
JLCPCB_ACCESS_KEY=
JLCPCB_SECRET_KEY=

# Future sources (not used yet)
# MOUSER_API_KEY=
# NEXAR_CLIENT_ID=
# NEXAR_CLIENT_SECRET=
